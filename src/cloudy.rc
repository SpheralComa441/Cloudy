    BLOCK "041004B0"
    BEGIN
      VALUE "CompanyName", "Cloudy"
      VALUE "FileDescription", "Claude Desktop Launcher (--disable-gpu-compositing)"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "Cloudy"
      VALUE "OriginalFilename", "Cloudy.exe"
      VALUE "ProductName", "Cloudy - Claude G-Sync Launcher"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0410, 1200
  END
END
